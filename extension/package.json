{
  "name": "angular-aitools",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run -s build:dev",
    "build:dev": "ng build --configuration development && npm run -s build:rest",
    "build:prod": "ng build && npm run -s build:devtools_page && npm run -s build:rest",
    "build:rest": "npm run -s build:devtools_page && npm run -s build:content_script && npm run -s build:injection && npm run -s build:manifest",
    "build:devtools_page": "cp -r devtools/ dist/angular-aitools/browser/devtools/",
    "build:content_script": "cp -r content_script/ dist/angular-aitools/browser/content_script/",
    "build:injection": "tsc -p tsconfig.injection.json --outdir dist/angular-aitools/browser/injection/",
    "build:manifest": "cp manifest.json dist/angular-aitools/browser/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.2",
    "@angular/cli": "^20.0.2",
    "@angular/compiler-cli": "^20.0.0",
    "@types/chrome": "^0.0.326",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
