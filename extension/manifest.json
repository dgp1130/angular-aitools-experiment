{
    "name": "Angular AITools",
    "version": "0.0.0",
    "manifest_version": 3,
    "devtools_page": "/devtools/index.html",
    "permissions": ["scripting", "activeTab"],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service_worker/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "js": ["content_script/index.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "externally_connectable": {
        "matches": ["<all_urls>"]
    },
    "web_accessible_resources": [
        {
            "resources": ["injection/*"],
            "matches": ["<all_urls>"]
        }
    ]
}
